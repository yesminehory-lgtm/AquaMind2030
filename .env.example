# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://aquamind:aquamind@localhost:5432/aquamind
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aquamind
DB_USER=aquamind
DB_PASSWORD=aquamind

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Open-Meteo (no key needed)
OPEN_METEO_URL=https://api.open-meteo.com/v1

# MQTT (optional – for real sensors)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC_SENSORS=aquamind/sensors/#

# SMS (optional – Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:5173
